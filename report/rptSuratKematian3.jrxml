	<queryString>
		<![CDATA[select pasien_meninggal.tanggal,pasien_meninggal.no_surat,pasien_meninggal.jam,pasien_meninggal.no_rkm_medis,pasien.nm_pasien, 
pasien.jk,pasien.tmp_lahir,pasien.tgl_lahir,pasien.no_ktp,pasien.alamat,pasien_meninggal.kd_dokter,dokter.nm_dokter 
